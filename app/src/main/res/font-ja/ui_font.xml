<?xml version="1.0" encoding="utf-8"?>
<!-- Шрифт интерфейса для японского: в Signika нет японских знаков.
     Файл урезан: латиница, кириллица, знаки препинания и только
     те японские знаки, что есть в values-ja/strings.xml.
     Если меняете японские строки — пересоберите файл шрифта. -->
<font-family xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <font
        android:font="@font/mplus_rounded_1c_regular"
        android:fontStyle="normal"
        android:fontWeight="400"
        app:font="@font/mplus_rounded_1c_regular"
        app:fontStyle="normal"
        app:fontWeight="400" />
</font-family>
